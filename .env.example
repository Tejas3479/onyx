# === Onyx Configuration ===

# Server
ENV=development
PORT=8000

# Authentication
API_KEYS=your-api-key-here
AUTH_DISABLED=true
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///data/onyx.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Playwright
MAX_PLAYWRIGHT_INSTANCES=3

# LLM (for price extraction)
OPENAI_API_KEY=sk-your-key-here
DEFAULT_LLM_MODEL=gpt-4o-mini

# Sessions
SESSION_TTL_MINUTES=30
MAX_SESSIONS=100
