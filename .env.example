# === Onyx Configuration ===

# Server
ENV=development
PORT=8000

# Authentication
API_KEYS=your-api-key-here
AUTH_DISABLED=false
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# LLM providers (for structured extraction / Tier 4 estimates)
GEMINI_API_KEY=your-gemini-api-key
SERPAPI_KEY=your-serpapi-key
OPENAI_API_KEY=sk-your-key-here
DEFAULT_LLM_MODEL=gpt-4o-mini

# Database
DATABASE_URL=sqlite+aiosqlite:///data/onyx.db

# Redis
REDIS_URL=redis://localhost:6379/0
# Fail-fast when Redis is absent so the app degrades to local-memory mode without stalling requests
REDIS_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=0.5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Demo Mode (offline, deterministic demos)
# true = Tier 3 serves fuzzy-matched demo cache, no network fetches
DEMO_MODE=true

# Deployment (for hosted demo)
# Comma-separated origins allowed for CORS + CSP connect-src (e.g. https://onyx-demo.fly.dev)
CORS_ORIGINS=http://localhost:8000
CSP_CONNECT_SRC=

# Playwright
MAX_PLAYWRIGHT_INSTANCES=3

# Sessions
SESSION_TTL_MINUTES=30
MAX_SESSIONS=100
